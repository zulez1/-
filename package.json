{
  "name": "sport-events-marketplace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @sem/api dev",
    "dev:web": "pnpm --filter @sem/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @sem/api prisma:migrate",
    "db:seed": "pnpm --filter @sem/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
